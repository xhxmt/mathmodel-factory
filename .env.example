# Copy to .env (gitignored). Keep only non-sensitive runtime settings here.
# scripts/load_secrets.sh loads the current production credentials from GCP
# Secret Manager and overrides stale environment values.

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west4
GCP_SOLVER_SERVICE=solver-api
GCP_SOLVER_BUCKET=your-gcp-project-id-solver-jobs

USE_CLOUD_SOLVER=false
CLOUD_THRESHOLD_TIME=300
CLOUD_SOLVER_TYPES=python,julia,matlab,R
USE_CLOUD_LOGGING=false

# Sensitive keys are intentionally absent. Do not add API tokens, JWT secrets,
# passwords, or provider credentials to this file. Add a Secret Manager mapping
# to scripts/load_secrets.sh before enabling a new production provider.
