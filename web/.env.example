# Copy to web/.env. This file is gitignored and must contain non-sensitive
# runtime settings only. Production secrets are loaded by
# ../../scripts/load_secrets.sh from GCP Secret Manager.

# GCP project used by scripts/load_secrets.sh and optional Cloud Solver calls.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west4
GCP_SOLVER_SERVICE=solver-api
CLOUD_SOLVER_QUARANTINED=true
CLOUD_SOLVER_IMPERSONATE_SERVICE_ACCOUNT=solver-invoker@your-gcp-project-id.iam.gserviceaccount.com

# API/network settings.
API_HOST=0.0.0.0
API_PORT=8000
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
MAX_UPLOAD_SIZE=104857600

# Public, read-only showcase. Values must be completed project base names.
SHOWCASE_PROJECTS=cumcm_2025_a,cumcm_2025_b,test_cumcm2024a_polished

# Optional consultation notifications. Keep tokens in Secret Manager if used.
CONSULT_TELEGRAM=0
TELEGRAM_CHAT_ID=

# The following sensitive keys are intentionally absent. Do not add them here:
# JWT_SECRET, JWT_SECRET_KEY, ADMIN_PASSWORD, MINERU_TOKEN,
# GEMINI_API_KEY, DEEPSEEK_API_KEY, TELEGRAM_BOT_TOKEN.
